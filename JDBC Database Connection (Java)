import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;

public class DatabaseManager {
    // Configuration parameters for SQL Server [8]
    private String url = "jdbc:sqlserver://localhost:1433;databaseName=StudentPerformanceDB";
    private String user = "your_username";
    private String password = "your_password";

    public Connection getConnection() {
        Connection conn = null;
        try {
            // Establishing communication between Java and SQL Server [7]
            conn = DriverManager.getConnection(url, user, password);
            System.out.println("Connection to SQL Server established successfully.");
        } catch (SQLException e) {
            System.err.println("JDBC Connection Error: " + e.getMessage());
        }
        return conn;
    }
}
